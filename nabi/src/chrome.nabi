/// The project's forum: GitHub Discussions on the toolchain repository.
pub const DISCUSSIONS: str = "https://github.com/nabi-lang/nabi/discussions";

/// The header's search palette button (js/palette.tsx), for a page with
/// no search field of its own: palette.js opens on its click, and on
/// Cmd+K or Ctrl+K anywhere (keys.js).
pub fn palette_button(ko: bool) -> str { palette_button_for(lang::of_ko(ko)) }

pub fn palette_button_for(l: lang::Lang) -> str {
    let label = l.words().search;
    f"<button class=\"ib pal-open\" type=\"button\" data-palette aria-label=\"{label}\" title=\"{label} (⌘K)\" aria-keyshortcuts=\"Control+K Meta+K\">{ICON_SEARCH}</button>"
}

const ICON_SEARCH: str = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4\"/></svg>";

/// Where the search palette looks: a docs version's root
/// (`https://docs.nabi-lang.org/latest/`; `""`: the page's data-root),
/// the package docs (`https://docs.nabi-lang.org/packages/`) and the
/// registry (`https://packages.nabi-lang.org`); `""` leaves one out.
pub struct Palette {
    pub docs: str = "";
    pub pkgdocs: str = "";
    pub registry: str = "";
}

/// The `<script>` of the search palette at `src` (palette.js, with its
/// `?v=`). The pages' CSP must let connect-src reach the other hosts.
pub fn palette_script(src: str, p: Palette) -> str {
    let b = StrBuf::new();
    b.push_str(f"<script src=\"{esc(src)}\"");
    for (k, v) in [("docs", p.docs), ("pkgdocs", p.pkgdocs), ("registry", p.registry)] {
        if !v.is_empty() { b.push_str(f" data-{k}=\"{esc(v)}\""); }
    }
    b.push_str(" defer></script>\n");
    b.to_str()
}

/// The Nabi sites, each by its address from the page at hand.
pub struct Sites {
    pub home: str;
    pub docs: str;
    pub registry: str;
    pub playground: str;
    /// `home`, `docs`, `registry` or `playground`: the site the page is on.
    pub current: str;
}

/// The bar's links to the Nabi sites, the current one marked.
pub fn sites_nav(s: Sites) -> str { sites_nav_in(s, false) }

/// sites_nav, in Korean if `ko`.
pub fn sites_nav_in(s: Sites, ko: bool) -> str { sites_nav_for(s, lang::of_ko(ko)) }

/// sites_nav in `l`.
pub fn sites_nav_for(s: Sites, l: lang::Lang) -> str {
    let w = l.words();
    let b = StrBuf::new();
    b.push_str(f"<nav aria-label=\"{w.sites}\">");
    for (key, text, href) in [("home", w.home, s.home), ("docs", w.docs, s.docs), ("registry", w.packages, s.registry), ("playground", w.playground, s.playground)] {
        let cur = if key == s.current { " aria-current=\"page\"" } else { "" };
        b.push_str(f"<a href=\"{esc(href)}\"{cur}>{text}</a>");
    }
    b.push_str("</nav>");
    b.to_str()
}

/// The Nabi sites as header links (`.nav.sites`), the current one marked
/// like any active header link.
pub fn header_sites(s: Sites, ko: bool) -> str { header_sites_for(s, lang::of_ko(ko)) }

pub fn header_sites_for(s: Sites, l: lang::Lang) -> str {
    sites_nav_for(s, l).replace("<nav aria-label=", "<nav class=\"nav sites\" aria-label=")
}

/// The body of a 404 page every Nabi site shares: a title, one plain
/// sentence (HTML) and where to go instead, each `(href, text)`.
pub fn not_found(title: str, sentence: str, links: List<(str, str)>) -> str {
    let b = StrBuf::new();
    for (href, text) in links { b.push_str(f"<li><a href=\"{esc(href)}\">{esc(text)}</a></li>"); }
    f"<div class=\"lost\"><h1 class=\"t-h1\">{esc(title)}</h1><p class=\"t-lead\">{sentence}</p><ul class=\"lost-links\">{b.to_str()}</ul></div>"
}

/// The wordmark (kit::WORDMARK_SVG) inline, its letters in `--wm` so
/// one file serves both themes; `label` names it for screen readers.
pub fn wordmark(label: str) -> str {
    let svg = pkg::kit::WORDMARK_SVG.trim();
    let at = svg.find(">") ?? 0;
    let head = svg[:at].replace(" role=\"img\"", "").replace(f" aria-label=\"Nabi\"", "");
    let body = svg[at:].replace("<title>Nabi</title>", "").replace("fill=\"#1F1B1E\"", "class=\"wm\"");
    f"{head} role=\"img\" aria-label=\"{esc(label)}\" height=\"28\"{body}"
}

/// The copyright notice every Nabi site carries (the same in every
/// language).
pub const MADE_BY: str = "<span>© 2026 <a href=\"https://daminstudio.com\">DaminStudio</a> and the Nabi contributors</span>";
pub const MADE_BY_KO: str = MADE_BY;
pub const LICENSE: str = "MIT OR Apache-2.0";
/// The footer's Security link on every Nabi site: one policy, the nabi
/// repository's, for the toolchain, the packages and the sites.
pub const SECURITY: str = "https://github.com/nabi-lang/nabi/security/policy";

/// When every site's security.txt stops being valid (RFC 9116 wants a year
/// at most): renew before then (CI checks it is more than 30 days away).
pub const SECURITY_EXPIRES: str = "2027-10-24T00:00:00.000Z";

/// `/.well-known/security.txt` of the site at `base` (`https://nabi-lang.org`),
/// the same on every Nabi site (RFC 9116).
pub fn security_txt(base: str) -> str {
    f"Contact: mailto:security@nabi-lang.org\nContact: {SECURITY}\nExpires: {SECURITY_EXPIRES}\nPreferred-Languages: en, ko\nCanonical: {base}/.well-known/security.txt\nPolicy: {SECURITY}\n"
}

/// A Copy button: copy.js puts `text` on the clipboard and says so.
pub fn copy_button(text: str, ko: bool) -> str { copy_button_for(text, lang::of_ko(ko)) }

pub fn copy_button_for(text: str, l: lang::Lang) -> str {
    let label = l.words().copy;
    f"<button type=\"button\" class=\"btn-2 btn-sm copy\" data-copy=\"{esc(text)}\" aria-label=\"{label}\">{label}</button>"
}

/// The footer of nabi-lang.org, the docs and packages.nabi-lang.org.
pub struct Footer {
    /// Where the brand goes, and its mark (`/nabi.svg`).
    pub home: str;
    pub logo: str;
    /// The sentence under the brand, as text.
    pub tagline: str;
    /// Link columns: a title and its links as HTML (`<a>`s).
    pub cols: List<(str, str)>;
    pub sites: Sites;
    /// HTML for the bar after the sites (release, licence) and after
    /// the copyright notice (notes), each a run of `<span>`s.
    pub before: str = "";
    pub after: str = "";
    /// Korean page: the theme switch, the sites and the bar speak Korean
    /// (the columns come as given).
    pub ko: bool = false;
    /// The page's language, over `ko`.
    pub lang: lang::Lang | none = none;
    /// The toolchain release. Set, the bar is the one every Nabi site
    /// shares: sites, `nabi <release>`, the licence, the copyright, `after`, the
    /// social links, the theme switch; `before` is then unused and the
    /// social links leave the brand column.
    pub release: str = "";
    /// The nabi-lang repository whose translation form the bar links to
    /// on a Chinese page (legal_links_with); "" for none.
    pub repo: str = "";
}

/// Where the shared footer's links go, from the page it is on: each a
/// prefix ending in `/` (absolute, or relative on the docs and home
/// pages, which link within their version).
pub struct Links {
    /// nabi-lang.org (`https://nabi-lang.org/`).
    pub home: str;
    /// A version's docs (`https://docs.nabi-lang.org/latest/`).
    pub docs: str;
    /// The docs host, for the packages' docs (`https://docs.nabi-lang.org/`).
    pub docs_host: str;
    pub registry: str;
    pub playground: str;
}

/// The footer's link columns, the same on every Nabi site: Docs,
/// Reference, Ecosystem and Project, in Korean if `ko`.
pub fn site_cols(l: Links, ko: bool) -> List<(str, str)> { site_cols_for(l, lang::of_ko(ko)) }

/// site_cols in `lg`, each link to its page in that language (the
/// registry has none).
pub fn site_cols_for(l: Links, lg: lang::Lang) -> List<(str, str)> {
    let w = lg.words();
    let k = lg.dir();
    let gh = "https://github.com/nabi-lang";
    let a = |href: str, text: str| f"<a href=\"{esc(href)}\">{text}</a>";
    let d = |p: str| l.docs + k + p;
    [
        (w.docs, a(d("learn"), w.guide) + a(d("examples"), w.examples) + a(d("errors"), w.error_codes) + a(l.docs_host + k + "packages", w.package_docs)),
        (w.reference, a(d("spec/refs-lang"), w.language_spec) + a(d("std"), w.std_library) + a(d("spec/refs-lang/009-tools"), w.tools)),
        (w.ecosystem, a(l.playground + lg.slug(), w.playground) + a(l.registry, w.packages) + a(d("learn/packages"), w.publishing) + a(gh + "/nabi.vscode", "VS Code") + a(gh + "/nabi.vim", "Vim") + a(gh + "/nabi.zed", "Zed")),
        (w.project, a(l.home + k + "news", w.news) + a(l.home + k + "releases", w.releases) + a(l.home + k + "roadmap", w.roadmap) + a(l.home + k + "faq", w.faq) + a(l.home + k + "community", w.community) + a(l.home + k + "governance", w.governance) + a(l.home + k + "brand", w.brand) + a(gh + "/nabi", "GitHub") + a(SECURITY, w.security) + a("mailto:contact@nabi-lang.org", w.contact)),
    ]
}

/// The legal links every footer's bar ends with: one privacy notice and
/// one set of terms for all of Nabi, on nabi-lang.org, and the registry's
/// usage policy.
pub fn legal_links(ko: bool) -> str { legal_links_for(lang::of_ko(ko)) }

pub fn legal_links_for(l: lang::Lang) -> str { legal_links_with(l, "") }

/// legal_links_for, and on a Chinese page a link that reports a
/// translation problem in nabi-lang/`repo` (its translation.yml form);
/// `repo` "" leaves it out. The Chinese text has had no native review.
pub fn legal_links_with(l: lang::Lang, repo: str) -> str {
    let w = l.words();
    let k = if l.is_en() { "" } else { "/" + l.slug() };
    f"<span class=\"legal\"><a href=\"https://nabi-lang.org{k}/privacy\">{w.privacy}</a><a href=\"https://nabi-lang.org{k}/terms\">{w.terms}</a><a href=\"https://packages.nabi-lang.org/policy\">{w.package_policy}</a>{report_link(l, repo)}</span>"
}

/// The link to report a translation problem: Chinese pages only.
pub fn report_link(l: lang::Lang, repo: str) -> str {
    let text = match l {
        lang::Lang::ZhHans => "反馈翻译问题",
        lang::Lang::ZhHant => "回報翻譯問題",
        _ => "",
    };
    if text.is_empty() || repo.is_empty() { return ""; }
    f"<a href=\"https://github.com/nabi-lang/{esc(repo)}/issues/new?template=translation.yml\">{text}</a>"
}

pub fn footer(f: Footer) -> str {
    let cols = StrBuf::new();
    for (title, links) in f.cols { cols.push_str(f"<div class=\"col\"><p class=\"t-label\">{esc(title)}</p>{links}</div>\n"); }
    let l = f.lang ?? lang::of_ko(f.ko);
    let made = MADE_BY;
    let (about_social, bar) = if f.release.is_empty() {
        (SOCIAL, f"{f.before}{made}{f.after}{legal_links_with(l, f.repo)}")
    } else {
        ("", f"<span class=\"mono\">nabi {esc(f.release)}</span><span>{LICENSE}</span>{made}{f.after}{legal_links_with(l, f.repo)}{SOCIAL}")
    };
    let tag = if f.tagline.is_empty() { "" } else { f"<p>{esc(f.tagline)}</p>" };
    f"<footer class=\"foot\" lang=\"{l.code()}\">
<div class=\"frame cols\">
<div class=\"about\"><a class=\"brand\" href=\"{esc(f.home)}\" lang=\"en\">{wordmark("Nabi")}</a>{tag}{about_social}</div>
{cols.to_str()}</div>
<div class=\"frame bar\">
{sites_nav_for(f.sites, l)}
{bar}
{theme_seg_for(l)}
</div>
</footer>
"
}

/// `html` with the Markdown renderer's aligned table cells
/// (`style="text-align:center"`) as nabi.css classes (`class="ta-c"`):
/// the sites' CSP refuses style attributes.
pub fn align_classes(html: str) -> str {
    if !html.contains(" style=\"text-align:") { return html; }
    html.replace(" style=\"text-align:left\"", " class=\"ta-l\"").replace(" style=\"text-align:center\"", " class=\"ta-c\"").replace(" style=\"text-align:right\"", " class=\"ta-r\"")
}

#[cfg(test)]
fn count(s: str, of: str) -> usize { s.split(of).count() - 1 }

#[test]
fn pieces() {
    assert(align_classes("<th style=\"text-align:center\">a</th><td>b</td><td style=\"text-align:right\">c</td>") == "<th class=\"ta-c\">a</th><td>b</td><td class=\"ta-r\">c</td>", "aligned cells");
    assert(esc("a<b & \"c\">") == "a&lt;b &amp; &quot;c&quot;&gt;", "esc");
    let tb = theme_button(false);
    assert(tb.contains("aria-label=\"Dark theme\"") && tb.contains("aria-pressed=\"false\"") && tb.contains("class=\"ib theme\""), "button");
    assert(theme_button(true).contains("다크 테마로 바꾸기"), "korean button");
    let seg = theme_seg(false);
    assert(count(seg, "data-theme-set=") == 3 && seg.contains("data-theme-set=\"auto\""), "switch");
    assert(count(SOCIAL, "<a ") == 4 && SOCIAL.contains(X) && SOCIAL.contains("github.com/nabi-lang") && SOCIAL.contains(f"href=\"{MASTODON}\" rel=\"me\"") && SOCIAL.contains(BLUESKY), "social");
    let wm = wordmark("Nabi home");
    assert(wm.starts_with("<svg") && wm.contains("aria-label=\"Nabi home\"") && wm.contains("class=\"wm\"") && !wm.contains("#1F1B1E"), "wordmark");
    let nav = sites_nav(Sites { home: "https://nabi-lang.org", docs: "/latest", registry: "https://packages.nabi-lang.org", playground: "https://playground.nabi-lang.org", current: "docs" });
    assert(nav.contains("<a href=\"/latest\" aria-current=\"page\">Docs</a>") && count(nav, "aria-current") == 1, "current site");
    assert(theme_script("../").contains("src=\"../theme.js\"") && icons("/").contains("href=\"/favicon.ico\""), "head");
    let h = head(Head { title: "T & U", site: "Nabi", desc: "d", img: "/og.png?v=1", img_w: 1200i64, img_h: 630i64, alt: "a", asset: |n| "/" + n + "?v=x" });
    assert(h.contains("<title>T &amp; U</title>") && h.contains("<script src=\"/theme.js?v=x\"></script>") && h.contains("href=\"/style.css?v=x\"") && !h.contains("canonical"), "head");
    assert(head(Head { title: "t", site: "s", desc: "d", url: "https://x/y", img: "i", img_w: 1i64, img_h: 1i64, alt: "", asset: |n| n, ko: true }).contains("<link rel=\"canonical\" href=\"https://x/y\">\n<meta property=\"og:type\""), "canonical");
    assert(fonts().contains("<link rel=\"preload\" href=\"/fonts/Geist-Variable.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>") && fonts().contains("href=\"/fonts/pretendard.css\""), "fonts");
    let en = fonts_in("../", false);
    assert(en.contains("href=\"../fonts/GeistMono-Variable.woff2\"") && !en.contains("pretendard") && !en.contains("https:"), "fonts, english, self-hosted");
}

#[test]
fn shared_footer_links() {
    let l = Links { home: "https://nabi-lang.org/", docs: "https://docs.nabi-lang.org/latest/", docs_host: "https://docs.nabi-lang.org/", registry: "https://packages.nabi-lang.org/", playground: "https://playground.nabi-lang.org/" };
    let en = site_cols(l, false);
    let ko = site_cols(l, true);
    assert(en.len() == 4 && en[0].1.contains("href=\"https://docs.nabi-lang.org/latest/learn\"") && en[0].1.contains("https://docs.nabi-lang.org/packages\""), "docs links");
    assert(ko[0].1.contains("https://docs.nabi-lang.org/latest/ko/learn\"") && ko[3].1.contains("https://nabi-lang.org/ko/news\"") && ko[2].1.contains("https://playground.nabi-lang.org/ko\""), "korean links");
    assert(en[3].1.contains("https://nabi-lang.org/community\"") && en[3].1.contains("https://nabi-lang.org/releases\"") && ko[3].1.contains("https://nabi-lang.org/ko/governance\"") && ko[3].1.contains("https://nabi-lang.org/ko/brand\""), "project pages");
    assert(legal_links(false).contains("https://nabi-lang.org/privacy") && legal_links(true).contains("https://nabi-lang.org/ko/terms"), "legal");
    let foot = footer(Footer { home: "/", logo: "/nabi.svg", tagline: "", cols: en, sites: Sites { home: "/", docs: "", registry: "", playground: "", current: "home" } });
    assert(foot.contains("class=\"legal\""), "legal in every footer");
}

#[test]
fn language_menu() {
    let m = lang_menu(false, [Lang { code: "en", name: "English" }, Lang { code: "ko", name: "한국어", href: "/ko/x" }], " data-sec=\"a b\"");
    assert(m.starts_with("<details class=\"lang-menu\" data-sec=\"a b\"><summary class=\"ib\" aria-label=\"Language\""), m);
    assert(m.contains("<span aria-current=\"true\" lang=\"en\">") && m.contains("<a href=\"/ko/x\" hreflang=\"ko\" lang=\"ko\">") && m.contains("한국어</a>"), m);
    assert(lang_menu(true, List::new()).contains("aria-label=\"언어\""), "korean label");
}

#[test]
fn footers() {
    let sites = Sites { home: "/", docs: "https://docs.nabi-lang.org/latest", registry: "https://packages.nabi-lang.org", playground: "https://playground.nabi-lang.org", current: "home" };
    let f = footer(Footer { home: "/", logo: "/logo.svg", tagline: "Fast & safe.", cols: [("Learn", "<a href=\"/learn\">Guide</a>")], sites: sites, before: "<span>v1</span>" });
    assert(f.starts_with("<footer class=\"foot\"") && f.contains("<p>Fast &amp; safe.</p>"), "about");
    assert(f.contains("<div class=\"col\"><p class=\"t-label\">Learn</p><a href=\"/learn\">Guide</a></div>"), "column");
    assert(f.contains("<span>v1</span><span>© 2026 <a href=\"https://daminstudio.com\">DaminStudio</a> and the Nabi contributors</span>"), "bar");
    assert(f.contains("lang=\"en\"><button"), "english switch");
    let g = footer(Footer { home: "/", logo: "/logo.svg", tagline: "t", cols: List::new(), sites: sites, release: "0.1.4", ko: true });
    assert(g.contains("<span class=\"mono\">nabi 0.1.4</span><span>MIT OR Apache-2.0</span><span>© 2026") && g.contains(">홈</a>"), "shared bar");
    assert(count(g, "class=\"social\"") == 1 && g.contains("<footer class=\"foot\" lang=\"ko\">"), "social once, korean");
    let z = footer(Footer { home: "/", logo: "/logo.svg", tagline: "t", cols: List::new(), sites: sites, release: "0.1.4", lang: lang::Lang::ZhHant, repo: "docs" });
    assert(z.contains("<a href=\"https://github.com/nabi-lang/docs/issues/new?template=translation.yml\">回報翻譯問題</a></span>"), "report link");
    assert(!g.contains("translation.yml") && !legal_links_with(lang::Lang::ZhHans, "").contains("translation.yml"), "report link only on zh with a repo");
    assert(header_sites(sites, false).starts_with("<nav class=\"nav sites\""), "header sites");
    assert(not_found("Gone", "No page <code>x</code>.", [("/", "Home")]).contains("<li><a href=\"/\">Home</a></li>"), "404");
    assert(copy_button("a\"b", false).contains("data-copy=\"a&quot;b\""), "copy");
    let pb = palette_button(true);
    assert(pb.contains("data-palette") && pb.contains("aria-label=\"검색\"") && pb.contains("class=\"ib pal-open\""), pb);
    let ps = palette_script("/palette.js?v=1", Palette { docs: "https://d/latest/", registry: "https://r" });
    assert(ps == "<script src=\"/palette.js?v=1\" data-docs=\"https://d/latest/\" data-registry=\"https://r\" defer></script>\n", ps);
}

#[test]
fn chinese() {
    let hans = lang::Lang::ZhHans;
    let hant = lang::Lang::ZhHant;
    assert(theme_button_for(hant).contains("aria-label=\"深色主題\"") && theme_seg_for(hans).contains("lang=\"zh-Hans\"") && theme_seg_for(hans).contains(">跟随系统</button>"), "theme");
    assert(palette_button_for(hant).contains("aria-label=\"搜尋\"") && copy_button_for("x", hans).contains(">复制</button>"), "search, copy");
    assert(!fonts_for("/", hans).contains("pretendard") && fonts_for("/", lang::Lang::Ko).contains("pretendard") && fonts_for("/", hant).contains("Geist-Variable"), "no webfont for Chinese");
    let l = Links { home: "https://nabi-lang.org/", docs: "https://docs.nabi-lang.org/latest/", docs_host: "https://docs.nabi-lang.org/", registry: "https://packages.nabi-lang.org/", playground: "https://playground.nabi-lang.org/" };
    let cols = site_cols_for(l, hant);
    assert(cols[0].0 == "文件" && cols[0].1.contains("https://docs.nabi-lang.org/latest/zh-hant/learn\"") && cols[0].1.contains("https://docs.nabi-lang.org/zh-hant/packages\""), cols[0].1);
    assert(cols[2].1.contains("https://playground.nabi-lang.org/zh-hant\"") && cols[3].1.contains("https://nabi-lang.org/zh-hant/news\""), "zh-Hant links");
    assert(site_cols_for(l, hans)[1].1.contains(">标准库</a>") && legal_links_for(hans).contains("https://nabi-lang.org/zh-hans/privacy\">隐私声明</a>"), "zh-Hans");
    assert(site_cols(l, true)[2].1 == site_cols_for(l, lang::Lang::Ko)[2].1 && legal_links(false) == legal_links_for(lang::Lang::En), "the bool forms");
    let sites = Sites { home: "/", docs: "", registry: "", playground: "", current: "home" };
    let f = footer(Footer { home: "/", logo: "/logo.svg", tagline: hans.words().tagline, cols: cols, sites: sites, release: "0.1.4", lang: hans });
    assert(f.contains("<footer class=\"foot\" lang=\"zh-Hans\">") && f.contains(">首页</a>") && f.contains("aria-label=\"Nabi 网站\"") && f.contains("<p>规则清晰，如蝶般自由。</p>"), "footer");
    let h = head(Head { title: "t", site: "s", desc: "d", img: "i", img_w: 1i64, img_h: 1i64, alt: "", asset: |n| n, lang: hant });
    assert(h.contains("<meta property=\"og:locale\" content=\"zh_TW\">") && !h.contains("pretendard"), "head");
    assert(!head(Head { title: "t", site: "s", desc: "d", img: "i", img_w: 1i64, img_h: 1i64, alt: "", asset: |n| n, ko: true }).contains("og:locale"), "no og:locale without a lang");
    let items = menu_items(hans, |m| if m == lang::Lang::Ko { "" } else { "/" + m.dir() + "x" });
    assert(items.len() == 3 && items[0].code == "en" && items[0].href == "/x" && items[1].href.is_empty() && items[2].href == "/zh-hant/x", "menu items");
    let m = lang_menu_for(hans, [Lang { code: "en", name: "English", href: "/x", sec: "a b" }, Lang { code: "zh-Hans", name: "简体中文" }]);
    assert(m.contains("aria-label=\"语言\"") && m.contains("<a href=\"/x\" hreflang=\"en\" lang=\"en\" data-sec=\"a b\">") && m.contains("<span aria-current=\"true\" lang=\"zh-Hans\">"), m);
}
