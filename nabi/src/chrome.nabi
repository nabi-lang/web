//! Markup the Nabi sites share: a page's <head>, the theme controls
//! theme.js drives, the social links, the bar of Nabi sites, the footer,
//! and the <head> lines for fonts, icons and theme.js. Hrefs and text are
//! escaped here; column links come as HTML.
//!
//! Each piece in a language has a `_for` form taking a lang::Lang; the
//! forms taking `ko: bool` are those for English and Korean.

use pkg::lang;

/// HTML-escaped `s`, for text and attribute values.
pub fn esc(s: str) -> str {
    s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

/// The webfonts (kit::FONTS_DIR, published as fonts/), from the site root: the two Geist files
/// nabi.css asks for on every page, preloaded so the text does not reflow
/// when they land, and Pretendard's stylesheet, which only Korean text
/// uses.
pub const FONT_FILES: [str; 2] = ["fonts/Geist-Variable.woff2", "fonts/GeistMono-Variable.woff2"];
pub const PRETENDARD: str = "fonts/pretendard.css";

/// theme.js, blocking: it must run before the first paint. `root` leads
/// to the site root (`/`, or `../` from a page one level down). Put it
/// right after `<meta name="theme-color">`.
pub fn theme_script(root: str) -> str { f"<script src=\"{root}theme.js\"></script>\n" }

/// The font preloads and Pretendard's stylesheet, from `/`.
pub fn fonts() -> str { fonts_in("/", true) }

/// fonts() from `root` (the same root as nabi.css, so a preload and the
/// stylesheet's request are one URL); Pretendard's stylesheet only if
/// the page holds Korean text (`ko`).
pub fn fonts_in(root: str, ko: bool) -> str { fonts_for(root, lang::of_ko(ko)) }

/// fonts_in for a page in `l`: Pretendard for Korean only. Chinese text
/// takes the system's CJK faces (nabi.css), no webfont.
pub fn fonts_for(root: str, l: lang::Lang) -> str {
    let b = StrBuf::new();
    for f in FONT_FILES { b.push_str(f"<link rel=\"preload\" href=\"{root}{f}\" as=\"font\" type=\"font/woff2\" crossorigin>\n"); }
    if l == lang::Lang::Ko { b.push_str(f"<link rel=\"stylesheet\" href=\"{root}{PRETENDARD}\">\n"); }
    b.to_str()
}

/// The kit's icons (kit.nabi names them), under `root`.
pub fn icons(root: str) -> str {
    f"<link rel=\"icon\" href=\"{root}favicon.svg\" type=\"image/svg+xml\">
<link rel=\"icon\" href=\"{root}favicon.ico\" sizes=\"32x32\">
<link rel=\"apple-touch-icon\" href=\"{root}apple-touch-icon.png\">
<link rel=\"manifest\" href=\"{root}site.webmanifest\">
"
}

/// A page's `<head>` lines (chrome::head).
pub struct Head {
    /// The whole `<title>`, also og:title.
    pub title: str;
    /// og:site_name.
    pub site: str;
    /// The description, HTML-escaped already.
    pub desc: str;
    /// The canonical address; `""`: none.
    pub url: str = "";
    /// The og:image (with its `?v=`), its pixel size and its text.
    pub img: str;
    pub img_w: i64;
    pub img_h: i64;
    pub alt: str;
    /// Leads to the fonts and icons (`/`, `../`).
    pub root: str = "/";
    /// The address of a site file by name (theme.js, nabi.css,
    /// style.css), with its `?v=`.
    pub asset: fn(str) -> str;
    /// Lines after the canonical link (robots, hreflang).
    pub extra: str = "";
    /// A Korean page: Pretendard too (fonts_in).
    pub ko: bool = false;
    /// The page's language, over `ko`: its fonts and its og:locale (none:
    /// no og:locale).
    pub lang: lang::Lang | none = none;
}

/// `<head>` from the charset to the icons, theme.js blocking before the
/// first paint.
pub fn head(h: Head) -> str {
    let img = esc(h.img);
    let alt = esc(h.alt);
    let canonical = if h.url.is_empty() { "" } else { f"<link rel=\"canonical\" href=\"{esc(h.url)}\">\n" };
    let og_url = if h.url.is_empty() { "" } else { f"<meta property=\"og:url\" content=\"{esc(h.url)}\">\n" };
    let l = h.lang ?? lang::of_ko(h.ko);
    let locale = if h.lang is none { "" } else { f"<meta property=\"og:locale\" content=\"{l.og_locale()}\">\n" };
    f"<meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
<title>{esc(h.title)}</title>
<meta name=\"color-scheme\" content=\"light dark\">
<meta name=\"theme-color\" content=\"#fcfbfb\">
<script src=\"{(h.asset)("theme.js")}\"></script>
<meta name=\"description\" content=\"{h.desc}\">
{canonical}{h.extra}<meta property=\"og:type\" content=\"website\">
{locale}<meta property=\"og:site_name\" content=\"{esc(h.site)}\">
<meta property=\"og:title\" content=\"{esc(h.title)}\">
<meta property=\"og:description\" content=\"{h.desc}\">
{og_url}<meta property=\"og:image\" content=\"{img}\">
<meta property=\"og:image:type\" content=\"image/png\">
<meta property=\"og:image:width\" content=\"{h.img_w}\">
<meta property=\"og:image:height\" content=\"{h.img_h}\">
<meta property=\"og:image:alt\" content=\"{alt}\">
<meta name=\"twitter:card\" content=\"summary_large_image\">
<meta name=\"twitter:image\" content=\"{img}\">
<meta name=\"twitter:image:alt\" content=\"{alt}\">
{fonts_for(h.root, l)}<link rel=\"stylesheet\" href=\"{(h.asset)("nabi.css")}\">
<link rel=\"stylesheet\" href=\"{(h.asset)("style.css")}\">
{icons(h.root)}"
}

pub const ICON_THEME: str = "<svg class=\"moon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/></svg><svg class=\"sun\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg>";

/// The header's theme button. Its name stays "Dark theme" and
/// aria-pressed says whether it is on; theme.js keeps aria-pressed and
/// the title (the action) in step.
pub fn theme_button(ko: bool) -> str { theme_button_for(lang::of_ko(ko)) }

pub fn theme_button_for(l: lang::Lang) -> str {
    let w = l.words();
    f"<button class=\"ib theme\" type=\"button\" aria-label=\"{w.dark_theme}\" aria-pressed=\"false\" title=\"{w.to_dark}\">{ICON_THEME}</button>"
}

const ICON_GLOBE: str = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z\"/></svg>";
const ICON_CHECK: str = "<svg class=\"ck\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>";

/// A language of a page in the language menu: its code, its name in
/// itself (`한국어`), and the page in it; `href` `""` is the page shown.
/// `sec` pairs the shown page's heading ids with those of the page in
/// this language, `"a1 b1 a2 b2 .."`, for a script that carries the
/// reader's section over (`data-sec` on the link).
pub struct Lang {
    pub code: str;
    pub name: str;
    pub href: str = "";
    pub sec: str = "";
}

/// The language menu's items for a page in `cur`: every language
/// (lang::ALL), the page in it at `href(l)`; `""` leaves a language out.
pub fn menu_items(cur: lang::Lang, href: fn(lang::Lang) -> str) -> List<Lang> {
    let out: List<Lang> = List::new();
    for l in lang::ALL {
        if l == cur {
            out.push(Lang { code: l.code(), name: l.name() });
            continue;
        }
        let h = href(l);
        if !h.is_empty() { out.push(Lang { code: l.code(), name: l.name(), href: h }); }
    }
    out
}

/// The header's language menu: an icon button beside the theme toggle,
/// opening the page in each language by its own name, the current one
/// checked. A `<details>`, so it opens and its links work without
/// scripts; theme.js closes it on Escape and outside clicks. `attrs` go
/// on the `<details>` (the docs' `class` and `data-sec`).
pub fn lang_menu(ko: bool, langs: List<Lang>, attrs: str = "") -> str { lang_menu_for(lang::of_ko(ko), langs, attrs) }

/// lang_menu on a page in `l`; menu_items lists every language.
pub fn lang_menu_for(cur: lang::Lang, langs: List<Lang>, attrs: str = "") -> str {
    let label = cur.words().language;
    let items = StrBuf::new();
    for l in langs {
        if l.href.is_empty() {
            items.push_str(f"<li><span aria-current=\"true\" lang=\"{esc(l.code)}\">{ICON_CHECK}{esc(l.name)}</span></li>");
        } else {
            let sec = if l.sec.is_empty() { "" } else { f" data-sec=\"{esc(l.sec)}\"" };
            items.push_str(f"<li><a href=\"{esc(l.href)}\" hreflang=\"{esc(l.code)}\" lang=\"{esc(l.code)}\"{sec}><span class=\"ck\"></span>{esc(l.name)}</a></li>");
        }
    }
    f"<details class=\"lang-menu\"{attrs}><summary class=\"ib\" aria-label=\"{label}\" title=\"{label}\">{ICON_GLOBE}</summary><ul class=\"lang-list\" aria-label=\"{label}\">{items.to_str()}</ul></details>"
}

/// The footer's System / Light / Dark switch.
pub fn theme_seg(ko: bool) -> str { theme_seg_for(lang::of_ko(ko)) }

pub fn theme_seg_for(l: lang::Lang) -> str {
    let w = l.words();
    f"<span class=\"seg\" role=\"group\" aria-label=\"{w.theme}\" lang=\"{l.code()}\"><button type=\"button\" data-theme-set=\"auto\" aria-pressed=\"false\">{w.system}</button><button type=\"button\" data-theme-set=\"light\" aria-pressed=\"false\">{w.light}</button><button type=\"button\" data-theme-set=\"dark\" aria-pressed=\"false\">{w.dark}</button></span>"
}

