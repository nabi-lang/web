//! The library source scanner behind the Nabi sites' API pages: the `pub`
//! items of a Nabi source file with their `///` docs, signatures as
//! written, members and trait impls, and the line each starts on. It
//! scans, not compiles: comments, strings and chars are masked out first,
//! so item boundaries are found by bracket depth alone. It never runs or
//! builds the code, so it is safe on untrusted sources.
//!
//! pages() turns the scanned modules into what the sites show: the public
//! modules, each with the items a `pub use` brings in from a private
//! module shown inline as its own (as rustdoc does), and the impls written
//! in private modules folded into their public parent. Rendering is the
//! sites' own; the navigation around it is nav's, shared with `nabi doc`.

pub mod nav;

use core::io::IoError;
use std::fs;
use std::nabion;

#[derive(Nabion)]
pub struct Member {
    pub name: str;
    pub sig: str;
    pub doc: str;
    /// 1-based line of the declaration in its file.
    pub line: usize;
    /// Its file when not its item's: an impl in a private module (pages).
    pub file: str = "";
}

#[derive(Nabion)]
pub struct Item {
    /// `fn`, `struct`, `enum`, `trait`, `type`, `const`, `static`, `use`.
    pub kind: str;
    pub name: str;
    pub sig: str;
    pub doc: str;
    /// Fields, variants, trait items, inherent methods.
    pub members: List<Member>;
    /// `impl Trait for Self` headers.
    pub traits: List<str>;
    /// 1-based line of the declaration; 0 for an impl of a foreign type.
    pub line: usize = 0usize;
    /// The source file of an item shown inline but declared in another
    /// module (pages); `""`: its module's file.
    pub file: str = "";
    /// Of a `use`: the names it brings in that pages() shows inline, so
    /// reexports() leaves them out.
    pub skip: List<str> = List::new();
}

#[derive(Nabion)]
pub struct Module {
    /// `core::collections::list`.
    pub path: str;
    /// Site path (`std/core/collections/list.html`).
    pub out: str;
    pub doc: str;
    pub items: List<Item>;
    /// Inherent impls of types not declared here (`impl str`), by type.
    pub impls: List<Item>;
    /// `pub mod x;` children by name.
    pub children: List<str>;
    /// Source file under library/ (`core/src/collections/list.nabi`).
    pub file: str = "";
    /// `mod x;`, `pub(pkg) mod x;` and `#[doc(hidden)]` children: read
    /// for what they re-export and implement, never shown.
    pub inner: List<str> = List::new();
    /// Reachable from outside: every module on its path is `pub`.
    pub public: bool = true;
}

/// One name a `pub use` brings in, and what it names among the scanned
/// modules: `BufReader` of `pub use core::io::buffer::{BufReader, ..}`.
pub struct Reexport {
    /// The name it has in the re-exporting module (after `as`); `*` for
    /// a glob.
    pub name: str;
    /// The path it names, made absolute when it resolved.
    pub path: str;
    /// The defining module (for a module re-export, the module itself).
    pub module: Module | none = none;
    /// The defining item; none for a module, a glob or an unresolved path.
    pub item: Item | none = none;
}

/// `src` with comments, strings and chars blanked (newlines kept).
fn mask(cs: List<char>) -> List<char> {
    let out: List<char> = List::new();
    for c in cs { out.push(c); }
    let i = 0usize;
    let n = cs.len();
    while i < n {
        let c = cs[i];
        let nx = if i + 1 < n { cs[i + 1] } else { ' ' };
        if c == '/' && nx == '/' {
            let k = i;
            while k < n && cs[k] != '\n' { k += 1; }
            blank(out, i, k);
            i = k;
        } else if c == '/' && nx == '*' {
            let k = i + 2;
            let depth = 1;
            while k < n && depth > 0 {
                if cs[k] == '/' && k + 1 < n && cs[k + 1] == '*' {
                    depth += 1;
                    k += 1;
                } else if cs[k] == '*' && k + 1 < n && cs[k + 1] == '/' {
                    depth -= 1;
                    k += 1;
                }
                k += 1;
            }
            blank(out, i, k);
            i = k;
        } else if c == '"' || ((c == 'f' || c == 'r' || c == 'b' || c == 'c') && (nx == '"' || (c == 'r' && nx == '#')) && (i == 0 || !is_ident(cs[i - 1]))) {
            let k = str_end(cs, i);
            blank(out, i, k);
            i = k;
        } else if c == '\'' {
            let k = char_end(cs, i);
            blank(out, i, k);
            i = if k > i { k } else { i + 1 };
        } else {
            i += 1;
        }
    }
    out
}

fn is_ident(c: char) -> bool { c.is_alphanumeric() || c == '_' }

fn blank(out: List<char>, a: usize, b: usize) {
    for k in a..b {
        if out[k] != '\n' { out[k] = ' '; }
    }
}

/// End of the char literal at `i`, or `i` if it is not one.
fn char_end(cs: List<char>, i: usize) -> usize {
    let n = cs.len();
    let k = i + 1;
    if k < n && cs[k] == '\\' { k += 2; } else { k += 1; }
    while k < n && k < i + 12 && cs[k] != '\'' && cs[k] != '\n' { k += 1; }
    if k < n && cs[k] == '\'' { k + 1 } else { i }
}

/// End of the string literal at `i` (`"`, `f"`, `r#"`, `f"""` ..).
fn str_end(cs: List<char>, i: usize) -> usize {
    let n = cs.len();
    let k = i;
    let fmt = cs[k] == 'f';
    let raw = cs[k] == 'r';
    if cs[k] != '"' { k += 1; }
    let hashes = 0usize;
    while k < n && cs[k] == '#' {
        hashes += 1;
        k += 1;
    }
    let triple = k + 2 < n && cs[k + 1] == '"' && cs[k + 2] == '"';
    k += if triple { 3 } else { 1 };
    while k < n {
        let c = cs[k];
        if c == '\\' && !raw {
            k += 2;
        } else if c == '"' && (!triple || (k + 2 < n && cs[k + 1] == '"' && cs[k + 2] == '"')) {
            let e = k + (if triple { 3 } else { 1 });
            let h = 0usize;
            while h < hashes && e < n && cs[e] == '#' {
                h += 1;
                e += 1;
            }
            if h == hashes { return e; }
            k += 1;
        } else if fmt && c == '{' && k + 1 < n && cs[k + 1] == '{' {
            k += 2;
        } else if fmt && c == '{' {
            k = hole_end(cs, k + 1);
        } else {
            k += 1;
        }
    }
    n
}

/// End of an f-string hole's code from `i` (after its `}`); strings in
/// it may reuse the quote.
fn hole_end(cs: List<char>, i: usize) -> usize {
    let n = cs.len();
    let k = i;
    let depth = 0;
    while k < n {
        let c = cs[k];
        if c == '"' || ((c == 'f' || c == 'r') && k + 1 < n && cs[k + 1] == '"' && !is_ident(cs[k - 1])) {
            k = str_end(cs, k);
            continue;
        }
        if c == '{' { depth += 1; }
        if c == '}' {
            if depth == 0 { return k + 1; }
            depth -= 1;
        }
        k += 1;
    }
    n
}

struct Scan {
    src: List<char>;
    m: List<char>;
    /// Offsets of the newlines, for line numbers.
    nl: List<usize>;
}

/// 1-based line of offset `at`.
fn line_of(s: Scan, at: usize) -> usize {
    let lo = 0usize;
    let hi = s.nl.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if s.nl[mid] < at { lo = mid + 1; } else { hi = mid; }
    }
    lo + 1
}

fn text(cs: List<char>, a: usize, b: usize) -> str {
    let out = StrBuf::new();
    for k in a..b { out.push(cs[k]); }
    out.to_str()
}

/// Matching close of the bracket at `i`.
fn close_of(m: List<char>, i: usize) -> usize {
    let depth = 0;
    let k = i;
    while k < m.len() {
        let c = m[k];
        if c == '(' || c == '[' || c == '{' { depth += 1; }
        if c == ')' || c == ']' || c == '}' {
            depth -= 1;
            if depth == 0 { return k; }
        }
        k += 1;
    }
    m.len()
}

/// One declaration in a body: `[start, head_end)` is its header (up to
/// its `{`, `;` or `,`), `body` the `{..}` range if any.
struct Decl {
    start: usize;
    head_end: usize;
    body_start: usize;
    body_end: usize;
}

/// The declarations in `m[a..b]`, split at `;` / `,` / a closing `}`.
fn decls(m: List<char>, a: usize, b: usize) -> List<Decl> {
    let out: List<Decl> = List::new();
    let i = a;
    while i < b {
        while i < b && (m[i].is_whitespace() || m[i] == ';' || m[i] == ',') { i += 1; }
        if i >= b { break; }
        let start = i;
        let k = i;
        let bs = 0usize;
        let be = 0usize;
        let body = false;
        // Generic arguments: `struct DictIter<K, V>` is one header. A `<`
        // right after a name (or `::`) opens them; `a < b` does not.
        let angle = 0;
        // `#[..]` attributes belong to the declaration.
        while k < b {
            let c = m[k];
            if c == '#' && k + 1 < b && m[k + 1] == '[' {
                k = close_of(m, k + 1) + 1;
                continue;
            }
            if c == '(' || c == '[' {
                k = close_of(m, k) + 1;
                continue;
            }
            if c == '<' && k > start && (is_ident(m[k - 1]) || m[k - 1] == ':') {
                angle += 1;
                k += 1;
                continue;
            }
            if c == '>' && angle > 0 && m[k - 1] != '-' && m[k - 1] != '=' {
                angle -= 1;
                k += 1;
                continue;
            }
            if c == '{' && angle > 0 {
                k = close_of(m, k) + 1;
                continue;
            }
            if c == ',' && angle > 0 {
                k += 1;
                continue;
            }
            // `use a::{B, C};` keeps its braces in the header.
            if c == '{' && is_use(m, start, k) {
                k = close_of(m, k) + 1;
                continue;
            }
            if c == '{' {
                bs = k;
                be = close_of(m, k);
                k = be + 1;
                // `= expr { .. }` initializers run on to their `;`.
                if !head_has(m, start, bs, '=') {
                    body = true;
                    break;
                }
                continue;
            }
            if c == ';' || c == ',' { break; }
            k += 1;
        }
        let head_end = if body { bs } else { k };
        if !body {
            bs = 0;
            be = 0;
        }
        out.push(Decl { start: start, head_end: head_end, body_start: bs, body_end: be });
        i = k + 1;
    }
    out
}

/// Whether the header in `m[a..b]` is a `use` (after `pub`, `pub(..)`).
fn is_use(m: List<char>, a: usize, b: usize) -> bool {
    let ws = words(m, a, b);
    let k = 0usize;
    while k < ws.len() && ws[k].starts_with("pub") { k += 1; }
    k < ws.len() && ws[k] == "use"
}

fn head_has(m: List<char>, a: usize, b: usize, c: char) -> bool {
    let depth = 0;
    for k in a..b {
        let x = m[k];
        if x == '(' || x == '[' || x == '<' { depth += 1; }
        // The `>` of `->` and `=>` closes nothing.
        if x == ')' || x == ']' || (x == '>' && !(k > a && (m[k - 1] == '-' || m[k - 1] == '='))) { depth -= 1; }
        if x == c && depth == 0 && !(k + 1 < b && m[k + 1] == '=') && !(k > 0 && (m[k - 1] == '=' || m[k - 1] == '!' || m[k - 1] == '<' || m[k - 1] == '>')) { return true; }
    }
    false
}

/// The `///` lines right above `start` (through attribute lines); none
/// for a declaration that does not start its line (`{ pub x: i32; }`).
fn doc_above(src: List<char>, start: usize) -> str {
    let lines: List<str> = List::new();
    let e = start;
    while e > 0 && src[e - 1] != '\n' {
        if !src[e - 1].is_whitespace() { return ""; }
        e -= 1;
    }
    while e > 0 {
        let b = e - 1;
        let a = b;
        while a > 0 && src[a - 1] != '\n' { a -= 1; }
        let l = text(src, a, b).trim();
        if l.starts_with("///") && !l.starts_with("////") {
            let t = l[3:];
            lines.push(if t.starts_with(" ") { t[1:] } else { t });
        } else if !l.starts_with("#[") {
            break;
        }
        e = a;
    }
    let out = StrBuf::new();
    let k = lines.len();
    while k > 0 {
        k -= 1;
        out.push_str(lines[k]);
        out.push('\n');
    }
    out.to_str()
}

/// Whether `d` carries `#[doc(hidden)]` (a compiler hook that is `pub`
/// only for lowered code) or `#[internal]` (shared by the toolchain's own
/// packages only): neither is documented.
fn hidden(s: Scan, d: Decl) -> bool {
    let h = text(s.m, d.start, d.head_end);
    h.contains("#[doc(hidden)]") || h.contains("#[internal]") || h.contains("#[internal(")
}

/// Words of a masked header after its attributes.
fn words(m: List<char>, a: usize, b: usize) -> List<str> {
    let out: List<str> = List::new();
    let k = a;
    while k < b {
        if m[k] == '#' && k + 1 < b && m[k + 1] == '[' {
            k = close_of(m, k + 1) + 1;
            continue;
        }
        if is_ident(m[k]) {
            let j = k;
            while j < b && is_ident(m[j]) { j += 1; }
            out.push(text(m, k, j));
            k = j;
        } else {
            if m[k] == '(' && out.len() > 0 && out[out.len() - 1] == "pub" {
                // `pub(pkg)`: keep the restriction as one word.
                let j = close_of(m, k);
                out[out.len() - 1] = "pub" + text(m, k, j + 1);
                k = j + 1;
                continue;
            }
            if !m[k].is_whitespace() { out.push(text(m, k, k + 1)); }
            k += 1;
        }
    }
    out
}

/// Where `d`'s header starts after its attributes.
fn sig_start(s: Scan, d: Decl) -> usize {
    let a = d.start;
    while a < d.head_end && s.m[a] == '#' {
        a = close_of(s.m, a + 1) + 1;
        while a < d.head_end && s.m[a].is_whitespace() { a += 1; }
    }
    a
}

/// Header text from the original source, attributes dropped, lines
/// dedented, trailing `{` / `;` / `,` gone.
fn sig(s: Scan, d: Decl) -> str {
    let a = d.start;
    while a < d.head_end && s.m[a] == '#' {
        a = close_of(s.m, a + 1) + 1;
        while a < d.head_end && s.m[a].is_whitespace() { a += 1; }
    }
    let col = 0usize;
    let k = a;
    while k > 0 && s.src[k - 1] != '\n' {
        k -= 1;
        col += 1;
    }
    let out = StrBuf::new();
    let first = true;
    for l in text(s.src, a, d.head_end).trim_end().lines() {
        if !first { out.push('\n'); }
        let t = l;
        if !first {
            let cut = 0usize;
            for c in l.chars() {
                if c != ' ' || cut == col { break; }
                cut += 1;
            }
            t = l[cut:];
        }
        out.push_str(t);
        first = false;
    }
    out.to_str().trim_end()
}

fn kind_of(ws: List<str>) -> (str, str, bool) {
    // (kind, name, public)
    let public = ws.len() > 0 && (ws[0] == "pub" || ws[0] == "pub(shy)");
    let k = 0usize;
    while k < ws.len() && (ws[k].starts_with("pub") || ws[k] == "async" || ws[k] == "unsafe" || ws[k] == "const" && k + 1 < ws.len() && ws[k + 1] == "fn") { k += 1; }
    if k >= ws.len() { return ("", "", false); }
    let kind = ws[k];
    let name = if k + 1 < ws.len() { ws[k + 1] } else { "" };
    if kind == "extern" && k + 1 < ws.len() && ws[k + 1] == "fn" { return ("fn", if k + 2 < ws.len() { ws[k + 2] } else { "" }, public); }
    (kind, name, public)
}

/// Members of a struct / enum / trait / impl body.
fn members(s: Scan, d: Decl, kind: str, trait_impl: bool) -> List<Member> {
    let out: List<Member> = List::new();
    if d.body_start == 0 || trait_impl { return out; }
    for m in decls(s.m, d.body_start + 1, d.body_end) {
        let ws = words(s.m, m.start, m.head_end);
        if ws.len() == 0 { continue; }
        let (k, _name, public) = kind_of(ws);
        let keep = if kind == "enum" {
            true
        } else if kind == "trait" {
            k == "fn" || k == "type" || k == "const"
        } else if kind == "impl" {
            public && (k == "fn" || k == "const" || k == "type")
        } else {
            public
        };
        if keep && !hidden(s, m) { out.push(Member { name: member_name(ws), sig: sig(s, m), doc: doc_above(s.src, m.start), line: line_of(s, sig_start(s, m)) }); }
    }
    out
}

/// The declared name: the first word that is not a modifier.
fn member_name(ws: List<str>) -> str {
    for w in ws {
        if w.starts_with("pub") || w == "async" || w == "unsafe" || w == "const" || w == "fn" || w == "type" || w == "static" { continue; }
        return w;
    }
    ""
}

/// Type name of an `impl` header's words (after `for` if any).
fn impl_target(ws: List<str>) -> (str, bool) {
    let k = 0usize;
    let depth = 0;
    let for_at = 0usize;
    while k < ws.len() {
        if ws[k] == "<" { depth += 1; }
        if ws[k] == ">" { depth -= 1; }
        if ws[k] == "for" && depth == 0 { for_at = k; }
        k += 1;
    }
    // Skip `impl` and its `<..>` parameters.
    let i = if for_at > 0 { for_at + 1 } else { 1 };
    if for_at == 0 && i < ws.len() && ws[i] == "<" {
        let depth = 0;
        while i < ws.len() {
            if ws[i] == "<" { depth += 1; }
            if ws[i] == ">" {
                depth -= 1;
                if depth == 0 { i += 1; break; }
            }
            i += 1;
        }
    }
    (if i < ws.len() { ws[i] } else { "" }, for_at > 0)
}

/// The public items of the source `src_text` of module `path`, whose
/// page is `out`; `pub mod x;` children by name.
pub fn scan(path: str, out: str, src_text: str) -> Module {
    let src: List<char> = List::new();
    for c in src_text.chars() { src.push(c); }
    let nl: List<usize> = List::new();
    for k in 0..src.len() {
        if src[k] == '\n' { nl.push(k); }
    }
    let s = Scan { src: src, m: mask(src), nl: nl };
    let md = Module { path: path, out: out, doc: lead_doc(src_text), items: List::new(), impls: List::new(), children: List::new() };
    let by_name: Dict<str, usize> = Dict::new();
    let impls: List<Decl> = List::new();
    for d in decls(s.m, 0, s.m.len()) {
        let ws = words(s.m, d.start, d.head_end);
        let (kind, name, public) = kind_of(ws);
        if kind == "impl" {
            impls.push(d);
            continue;
        }
        // A file module (`mod x;`): shown when public, else read for
        // what it re-exports.
        if kind == "mod" && d.body_start == 0 && !name.is_empty() {
            if public && !hidden(s, d) { md.children.push(name); } else { md.inner.push(name); }
            continue;
        }
        if !public || hidden(s, d) { continue; }
        if kind == "mod" { continue; }
        let k = if kind == "union" { "struct" } else { kind };
        if !(k == "fn" || k == "struct" || k == "enum" || k == "trait" || k == "type" || k == "const" || k == "static" || k == "use") { continue; }
        let it = Item { kind: k, name: if k == "use" { sig(s, d)["pub use ".len():] } else { name }, sig: sig(s, d), doc: doc_above(s.src, d.start), members: members(s, d, k, false), traits: List::new(), line: line_of(s, sig_start(s, d)) };
        if k != "use" { by_name.insert(name, md.items.len()); }
        md.items.push(it);
    }
    for d in impls {
        let ws = words(s.m, d.start, d.head_end);
        let (ty, is_trait) = impl_target(ws);
        let target = if let i: usize = by_name.get(ty) {
            md.items[i]
        } else {
            let found: Item | none = none;
            for it in md.impls {
                if it.name == ty { found = it; }
            }
            if let it: Item = found {
                it
            } else {
                let it = Item { kind: "impl", name: ty, sig: "", doc: "", members: List::new(), traits: List::new() };
                md.impls.push(it);
                it
            }
        };
        if is_trait {
            target.traits.push(sig(s, d));
        } else {
            target.members.extend(members(s, d, "impl", false));
        }
    }
    // Foreign types with only trait impls are noise.
    let kept: List<Item> = List::new();
    for it in md.impls {
        if it.members.len() > 0 { kept.push(it); }
    }
    md.impls = kept;
    md
}

/// The file's module doc: its leading `//!` lines (after a `#!` line).
/// Plain `//` comments are no doc, as for `nabi doc`.
pub fn lead_doc(src: str) -> str {
    let out = StrBuf::new();
    let first = true;
    for l in src.lines() {
        let t = l.trim();
        if first && t.starts_with("#!") && !t.starts_with("#![") {
            first = false;
            continue;
        }
        first = false;
        if !t.starts_with("//!") { break; }
        let body = t[3:];
        out.push_str(if body.starts_with(" ") { body[1:] } else { body });
        out.push('\n');
    }
    out.to_str()
}

/// The page of module `rel` (its path below the package root) when the
/// root's page is `dir/index.html`: the path as directories and `.html`,
/// but a child named `index` gets `dir/index/index.html`, not the
/// root's page. The rule `nabi doc` uses.
pub fn page_of(dir: str, rel: List<str>) -> str {
    if rel.is_empty() { return dir + "/index.html"; }
    if rel.len() == 1 && rel[0] == "index" { return dir + "/index/index.html"; }
    dir + "/" + rel.join("/") + ".html"
}

/// An item's id on its page, as `nabi doc` spells it: `struct.List`,
/// `impl.str`; a re-export by the names it brings in (`*` as `all`),
/// `reexport.List.ListIter` for `use list::{List, ListIter}`. A member's
/// is `<Type>.<member>` (`List.push`).
pub fn anchor(it: Item) -> str {
    if it.kind == "impl" { return "impl." + it.name; }
    if it.kind != "use" { return it.kind + "." + it.name; }
    let tail = it.name;
    if let k: usize = tail.find("{") { tail = tail[k + 1:]; } else if let k: usize = tail.rfind("::") { tail = tail[k + 2:]; }
    let names: List<str> = List::new();
    for w in tail.replace("}", "").replace(" as ", ",").split(",") {
        let n = w.trim();
        if let k: usize = n.rfind("::") { n = n[k + 2:]; }
        if !n.is_empty() { names.push(if n == "*" { "all" } else { n }); }
    }
    "reexport." + names.join(".")
}

/// Every module reachable from `file` (module `path`, page `out`; `""`
/// for none) through `mod` items, DFS, public ones first at each level;
/// `read` gives a file's text, none when it has none. A child is `x.nabi`
/// beside its parent's directory, else `x/mod.nabi`; one not found, and
/// one read already (a `#[cfg]` pair), is skipped. Public children's
/// pages follow page_of from `out`'s directory.
pub fn walk(read: fn(str) -> (str | none), file: str, path: str, out: str) -> List<Module> {
    let mods: List<Module> = List::new();
    let seen: Set<str> = Set::new();
    let dir = out.strip_suffix("/index.html") ?? (out.strip_suffix(".html") ?? out);
    walk_at(read, file, path, out, dir, List::new(), true, mods, seen);
    mods
}

fn walk_at(read: fn(str) -> (str | none), file: str, path: str, out: str, dir: str, rel: List<str>, public: bool, mods: List<Module>, seen: Set<str>) {
    if seen.contains(path) { return; }
    let f = file;
    let text = read(f) ?? {
        // `x.nabi` missing: `x/mod.nabi`.
        if !f.ends_with(".nabi") || f.ends_with("lib.nabi") || f.ends_with("mod.nabi") { return; }
        f = f[:f.len() - ".nabi".len()] + "/mod.nabi";
        read(f) ?? { return; }
    };
    seen.insert(path);
    let m = scan(path, out, text);
    m.file = f;
    m.public = public;
    mods.push(m);
    let src = if f == "lib.nabi" || f.ends_with("/lib.nabi") { f[:f.len() - "lib.nabi".len()] } else if f.ends_with("/mod.nabi") { f[:f.len() - "mod.nabi".len()] } else { f[:f.len() - ".nabi".len()] + "/" };
    for c in m.children {
        let sub: List<str> = List::new();
        sub.extend(rel);
        sub.push(c);
        walk_at(read, src + c + ".nabi", path + "::" + c, if dir.is_empty() { "" } else { page_of(dir, sub) }, dir, sub, public, mods, seen);
    }
    for c in m.inner { walk_at(read, src + c + ".nabi", path + "::" + c, "", "", List::new(), false, mods, seen); }
}

/// The modules of the standard library under `lib` (`library/`): the
/// tiers `bare`, `core`, `std`, each from `<tier>/src/lib.nabi`, pages
/// at `std/<tier>/..`. pages() gives what to show.
pub fn collect(lib: str) throws (IoError) -> List<Module> {
    let mods: List<Module> = List::new();
    for tier in ["bare", "core", "std"] {
        // A tier that cannot be read is an error, not an empty API.
        _ = try fs::read_to_str(lib + "/" + tier + "/src/lib.nabi");
        mods.extend(walk(|f| if fs::exists(lib + "/" + f) { try fs::read_to_str(lib + "/" + f) catch _ { none } } else { none }, tier + "/src/lib.nabi", tier, f"std/{tier}/index.html"));
    }
    mods
}

/// The paths a `use` tree names, each with the name it binds:
/// `a::{B, c::D as E, self}` gives (`a::B`, `B`), (`a::c::D`, `E`), (`a`, `a`).
pub fn use_paths(tree: str) -> List<(str, str)> {
    let out: List<(str, str)> = List::new();
    tree_paths("", tree.replace("\n", " "), out);
    out
}

fn tree_paths(prefix: str, tree: str, out: List<(str, str)>) {
    let t = tree.trim();
    t = (t.strip_suffix(";") ?? t).trim();
    if t.is_empty() { return; }
    if let k: usize = t.find("{") {
        let head = t[:k].trim().trim_end_matches("::");
        let e = t.rfind("}") ?? t.len();
        let inner = if e > k { t[k + 1:e] } else { t[k + 1:] };
        for part in split_top(inner) { tree_paths(join_path(prefix, head), part, out); }
        return;
    }
    let p = t;
    let name = "";
    if let k: usize = t.find(" as ") {
        p = t[:k].trim();
        name = t[k + 4:].trim();
    }
    let full = if p == "self" { prefix } else { join_path(prefix, p) };
    if name.is_empty() { name = last_seg(full); }
    if !full.is_empty() { out.push((full, name)); }
}

fn join_path(a: str, b: str) -> str {
    if a.is_empty() { return b; }
    if b.is_empty() { return a; }
    a + "::" + b
}

fn last_seg(path: str) -> str {
    if let k: usize = path.rfind("::") { path[k + 2:] } else { path }
}

/// `s` split at the commas outside braces, blank parts dropped.
fn split_top(s: str) -> List<str> {
    let out: List<str> = List::new();
    let cur = StrBuf::new();
    let depth = 0;
    for c in s.chars() {
        if c == '{' { depth += 1; }
        if c == '}' { depth -= 1; }
        if c == ',' && depth == 0 {
            if !cur.to_str().trim().is_empty() { out.push(cur.to_str()); }
            cur.clear();
            continue;
        }
        cur.push(c);
    }
    if !cur.to_str().trim().is_empty() { out.push(cur.to_str()); }
    out
}

/// The `use` tree of a `use` item's signature (`pub use a::{B, C}`).
fn use_tree(sig: str) -> str {
    if let k: usize = sig.find("use ") { sig[k + 4:] } else { sig }
}

fn module_at(mods: List<Module>, path: str) -> Module | none {
    for m in mods {
        if m.path == path { return m; }
    }
    none
}

/// Absolute paths `path`, written in module `m`, may mean, likeliest
/// first: as written, `self::` / `super::` / `pkg::` / `crate::` taken
/// apart, else relative to `m` and then to each module above it.
fn candidates(m: Module, mods: List<Module>, path: str) -> List<str> {
    let out: List<str> = List::new();
    let up = |p: str| if let k: usize = p.rfind("::") { p[:k] } else { "" };
    if let r: str = path.strip_prefix("self::") {
        out.push(join_path(m.path, r));
        return out;
    }
    if let r: str = path.strip_prefix("super::") {
        out.push(join_path(up(m.path), r));
        return out;
    }
    let rooted = path.strip_prefix("pkg::") ?? path.strip_prefix("crate::");
    if let r: str = rooted {
        // The crate root: the outermost scanned module above `m`.
        let root = m.path;
        let p = m.path;
        while !p.is_empty() {
            if let _q: Module = module_at(mods, p) { root = p; }
            p = up(p);
        }
        out.push(join_path(root, r));
        return out;
    }
    out.push(path);
    let p = m.path;
    while !p.is_empty() {
        out.push(join_path(p, path));
        p = up(p);
    }
    out
}

/// The item or module the absolute path `path` names, through re-exports
/// (at most `depth` more of them).
fn lookup(mods: List<Module>, path: str, depth: usize) -> (Module, Item | none) | none {
    let k = path.rfind("::") ?? 0;
    if k > 0 {
        let name = path[k + 2:];
        if let q: Module = module_at(mods, path[:k]) {
            for it in q.items {
                if it.kind != "use" && it.name == name { return (q, it); }
            }
            if depth > 0 {
                for it in q.items {
                    if it.kind != "use" { continue; }
                    for (p, n) in use_paths(use_tree(it.sig)) {
                        if n != name { continue; }
                        for c in candidates(q, mods, p) {
                            if let found: (Module, Item | none) = lookup(mods, c, depth - 1) { return found; }
                        }
                    }
                }
            }
        }
    }
    if let q: Module = module_at(mods, path) { return (q, none); }
    none
}

/// What each name of the `use` item `it` of module `m` refers to among
/// `mods`, in the order written.
pub fn reexports(m: Module, it: Item, mods: List<Module>) -> List<Reexport> {
    let out: List<Reexport> = List::new();
    for (path, name) in use_paths(use_tree(it.sig)) {
        if it.skip.contains(name) { continue; }
        let r = Reexport { name: name, path: path };
        if name != "*" {
            for c in candidates(m, mods, path) {
                if let found: (Module, Item | none) = lookup(mods, c, 8usize) {
                    let (q, item) = found;
                    r.path = c;
                    r.module = q;
                    r.item = item;
                    break;
                }
            }
        } else {
            let base = path.trim_end_matches("::*");
            for c in candidates(m, mods, base) {
                if let q: Module = module_at(mods, c) {
                    r.path = c + "::*";
                    r.module = q;
                    break;
                }
            }
        }
        out.push(r);
    }
    out
}

/// The item `path`, re-exported by `pub use` in module `m`, names when
/// the way to it stays in private modules: shown inline by pages(). None
/// when it reaches a public module (the item has a page there), names a
/// module, or names nothing scanned.
fn hidden_target(mods: List<Module>, m: Module, path: str, depth: usize) -> (Module, Item) | none {
    for c in candidates(m, mods, path) {
        let k = c.rfind("::") ?? { continue; };
        let name = c[k + 2:];
        if let q: Module = module_at(mods, c[:k]) {
            if let found: (Module, Item) = chase(mods, q, name, depth) { return found; }
            // `json::X` in package `json` with a `mod json;`: the crate
            // root (`m` itself) is not where `X` is, the child may be.
            if q.path != m.path && names(q, name) { return none; }
            continue;
        }
        if module_at(mods, c) is Module { return none; }
    }
    none
}

/// Whether module `q` declares or re-exports `name`.
fn names(q: Module, name: str) -> bool {
    for it in q.items {
        if it.kind != "use" && it.name == name { return true; }
        if it.kind == "use" {
            for (_p, n) in use_paths(use_tree(it.sig)) {
                if n == name || n == "*" { return true; }
            }
        }
    }
    false
}

/// `name` in the private module `q`: an item of its own, else what one of
/// its `pub use` items (globs too) brings in, at most `depth` deep.
fn chase(mods: List<Module>, q: Module, name: str, depth: usize) -> (Module, Item) | none {
    if q.public { return none; }
    for it in q.items {
        if it.kind != "use" && it.name == name { return (q, it); }
    }
    if depth == 0 { return none; }
    for it in q.items {
        if it.kind != "use" { continue; }
        for (p, n) in use_paths(use_tree(it.sig)) {
            let target = if n == name { p } else if n == "*" { p.trim_end_matches("*") + name } else { continue; };
            if let found: (Module, Item) = hidden_target(mods, q, target, depth - 1) { return found; }
        }
    }
    none
}

/// The module a glob `pub use a::*` of module `m` names.
fn glob_module(mods: List<Module>, m: Module, path: str) -> Module | none {
    for c in candidates(m, mods, path.trim_end_matches("::*")) {
        if let q: Module = module_at(mods, c) { return q; }
    }
    none
}

/// `sig` with the declared name `from` (after `kind`) changed to `to`, as
/// `pub use a::B as C` shows `B`: `pub struct C<T>`.
fn renamed(sig: str, kind: str, from: str, to: str) -> str {
    let key = kind + " " + from;
    let k = sig.find(key) ?? { return sig; };
    let rest = sig[k + key.len():];
    for c in rest.chars() {
        if is_ident(c) { return sig; }
        break;
    }
    sig[:k] + kind + " " + to + rest
}

/// A copy of `x` to change, shown as `name`; `q` is where it is declared.
/// A doc on the `pub use` (`doc`) comes first.
fn shown_as(x: Item, name: str, q: Module, doc: str) -> Item {
    let ms: List<Member> = List::new();
    ms.extend(x.members);
    let ts: List<str> = List::new();
    ts.extend(x.traits);
    let sk: List<str> = List::new();
    sk.extend(x.skip);
    let d = if doc.trim().is_empty() { x.doc } else if x.doc.trim().is_empty() { doc } else { doc + "\n" + x.doc };
    Item { kind: x.kind, name: name, sig: if name == x.name { x.sig } else { renamed(x.sig, x.kind, x.name, name) }, doc: d, members: ms, traits: ts, line: x.line, file: if x.file.is_empty() { q.file } else { x.file }, skip: sk }
}

/// A `pub use` of the absolute `path` as `name`, declared in `q`: what a
/// glob of a private module re-exports from a public one.
fn use_of(path: str, name: str, q: Module, line: usize) -> Item {
    let tree = if last_seg(path) == name { path } else { path + " as " + name };
    Item { kind: "use", name: tree, sig: "pub use " + tree, doc: "", members: List::new(), traits: List::new(), line: line, file: q.file }
}

/// What a glob of the private module `q` brings into `v`: each item, inline
/// unless `v` has the name, and each of its re-exports (inline when it
/// stays private, else as a `use`).
fn glob_into(mods: List<Module>, q: Module, v: Module, names: Set<str>, depth: usize) {
    for x in q.items {
        if x.kind == "use" || names.contains(x.name) { continue; }
        names.insert(x.name);
        v.items.push(shown_as(x, x.name, q, ""));
    }
    if depth == 0 { return; }
    for it in q.items {
        if it.kind != "use" { continue; }
        for (p, n) in use_paths(use_tree(it.sig)) {
            if n == "*" {
                if let g: Module = glob_module(mods, q, p) {
                    if !g.public {
                        glob_into(mods, g, v, names, depth - 1);
                        continue;
                    }
                }
            }
            if names.contains(n) { continue; }
            names.insert(n);
            if let found: (Module, Item) = hidden_target(mods, q, p, depth - 1) {
                let (d, x) = found;
                v.items.push(shown_as(x, n, d, it.doc));
                continue;
            }
            let abs = p;
            let base = if n == "*" { p.trim_end_matches("::*") } else { p };
            for c in candidates(q, mods, base) {
                let hit = if n == "*" { module_at(mods, c) is Module } else { lookup(mods, c, 8usize) is (Module, Item | none) };
                if hit {
                    abs = if n == "*" { c + "::*" } else { c };
                    break;
                }
            }
            v.items.push(use_of(abs, n, q, it.line));
        }
    }
}

/// The nearest public module above the private module `p`.
fn public_parent(mods: List<Module>, p: Module) -> Module | none {
    let path = p.path;
    while let k: usize = path.rfind("::") {
        path = path[:k];
        if let q: Module = module_at(mods, path) {
            if q.public { return q; }
        }
    }
    none
}

/// The public modules of `mods` (from walk / collect) as the API pages
/// show them, in the same order. A `pub use` of an item declared in a
/// private module (or reached only through private modules) shows the
/// item inline, as if declared here: signature, docs, members, trait
/// impls, under the name it is re-exported as; so does each item of a
/// `pub use private::*`. Re-exports of what a public module declares stay
/// `use` items that link there (reexports). The methods of an `impl`
/// written in a private module join the type in its nearest public parent
/// module, or that module's impls.
pub fn pages(mods: List<Module>) -> List<Module> {
    let out: List<Module> = List::new();
    let at: Dict<str, usize> = Dict::new();
    for m in mods {
        if !m.public { continue; }
        let v = Module { path: m.path, out: m.out, doc: m.doc, items: List::new(), impls: List::new(), children: m.children, file: m.file, inner: m.inner };
        let names: Set<str> = Set::new();
        for it in m.items {
            if it.kind != "use" { names.insert(it.name); }
        }
        for it in m.items {
            if it.kind != "use" {
                v.items.push(shown_as(it, it.name, m, ""));
                continue;
            }
            let skip: List<str> = List::new();
            let all = use_paths(use_tree(it.sig));
            for (p, n) in all {
                if n == "*" {
                    if let q: Module = glob_module(mods, m, p) {
                        if !q.public {
                            glob_into(mods, q, v, names, 8usize);
                            skip.push(n);
                        }
                    }
                    continue;
                }
                let found = hidden_target(mods, m, p, 8usize) ?? { continue; };
                let (q, x) = found;
                if names.contains(n) { continue; }
                names.insert(n);
                v.items.push(shown_as(x, n, q, it.doc));
                skip.push(n);
            }
            if skip.len() == all.len() { continue; }
            let u = shown_as(it, it.name, m, "");
            u.file = "";
            u.skip = skip;
            v.items.push(u);
        }
        for it in m.impls { v.impls.push(shown_as(it, it.name, m, "")); }
        at.insert(m.path, out.len());
        out.push(v);
    }
    for p in mods {
        if p.public { continue; }
        let a = public_parent(mods, p) ?? { continue; };
        let v = out[at.get(a.path) ?? { continue; }];
        for ii in p.impls {
            let target: Item | none = none;
            for x in v.items {
                if x.kind != "use" && x.kind != "fn" && x.kind != "const" && x.kind != "static" && x.name == ii.name { target = x; }
            }
            if target is none {
                for x in v.impls {
                    if x.name == ii.name { target = x; }
                }
            }
            if let t: Item = target {
                for mb in ii.members { t.members.push(Member { name: mb.name, sig: mb.sig, doc: mb.doc, line: mb.line, file: p.file }); }
                t.traits.extend(ii.traits);
                continue;
            }
            v.impls.push(shown_as(ii, ii.name, p, ""));
        }
    }
    out
}

#[test]
fn use_lists() {
    let m = scan("x", "x.html", "/// Re-exported.\npub use a::{B, C};\npub fn f() {}\n");
    assert(m.items.len() == 2 && m.items[0].kind == "use" && m.items[0].sig == "pub use a::{B, C}", m.items[0].sig);
    assert(m.items[0].name == "a::{B, C}" && m.items[1].name == "f" && m.items[1].line == 3, "names, lines");
}

#[test]
fn use_trees() {
    let ps = use_paths("a::{B, c::{D as E, self}, f::*};");
    assert(ps.len() == 4 && ps[0].0 == "a::B" && ps[0].1 == "B", "plain");
    assert(ps[1].0 == "a::c::D" && ps[1].1 == "E", "renamed");
    assert(ps[2].0 == "a::c" && ps[2].1 == "c", "self");
    assert(ps[3].0 == "a::f::*" && ps[3].1 == "*", "glob");
    assert(use_paths("std::io::SeekFrom").len() == 1 && use_paths("std::io::SeekFrom")[0].1 == "SeekFrom", "one");
}

#[test]
fn reexport_targets() {
    let top = scan("core::io", "std/core/io.html", "pub mod buffer;\npub mod more;\npub use core::io::buffer::{BufReader, LineWriter as Lines, read_all};\npub use more::Again;\npub use pkg::io::more;\npub use buffer::*;\npub use core::nowhere::Gone;\n");
    let buffer = scan("core::io::buffer", "std/core/io/buffer.html", "/// Buffers.\npub struct BufReader {}\npub struct LineWriter {}\npub fn read_all() {}\n");
    let more = scan("core::io::more", "std/core/io/more.html", "pub use pkg::io::buffer::BufReader as Again;\n");
    let root = scan("core", "std/core/index.html", "pub mod io;\n");
    let mods = [root, top, buffer, more];
    let rs: List<Reexport> = List::new();
    for it in top.items { rs.extend(reexports(top, it, mods)); }
    assert(rs.len() == 7, f"{rs.len()}");
    let at = |r: Reexport| {
        let page = if let q: Module = r.module { q.out } else { "" };
        let kind = if let i: Item = r.item { i.kind + "." + i.name } else { "-" };
        f"{r.name} {page} {kind}"
    };
    assert(at(rs[0]) == "BufReader std/core/io/buffer.html struct.BufReader", at(rs[0]));
    assert(at(rs[1]) == "Lines std/core/io/buffer.html struct.LineWriter", at(rs[1]));
    assert(at(rs[2]) == "read_all std/core/io/buffer.html fn.read_all", at(rs[2]));
    // Relative, then through a second re-export.
    assert(at(rs[3]) == "Again std/core/io/buffer.html struct.BufReader", at(rs[3]));
    assert(at(rs[4]) == "more std/core/io/more.html -", at(rs[4]));
    assert(at(rs[5]) == "* std/core/io/buffer.html -" && rs[5].path == "core::io::buffer::*", at(rs[5]));
    assert(at(rs[6]) == "Gone  -", at(rs[6]));
}

#[test]
fn arrows_in_bounds() {
    // The `>` of `->` must not close the `<` of a later bound, or the
    // `=` in it reads as an initializer and the item runs on through the
    // traits after it.
    let src = "pub fn fold<T>(g: fn(T) -> T) where T: Add<Output = T> {\n    match g { _ => 0 }\n}\n\n/// Back.\npub trait DoubleEndedIterator: Iterator {\n    fn next_back(ref self) -> Item | none;\n}\n\npub trait ExactSizeIterator: Iterator {\n    fn len(self) -> usize;\n}\n\npub trait IntoIterator {\n    type IntoIter: Iterator<Item = Item>;\n    fn into_iter(self) -> IntoIter;\n}\n\nimpl<I: Iterator> IntoIterator for I {\n    type IntoIter = I;\n    const fn into_iter(self) -> I { self }\n}\n\npub trait FromIterator<A> {\n    fn from_iter<I: IntoIterator<Item = A>>(it: I) -> Self;\n}\n";
    let m = scan("core::iter", "std/core/iter.html", src);
    let names: List<str> = List::new();
    for it in m.items { names.push(it.kind + "." + it.name); }
    assert(names.join(" ") == "fn.fold trait.DoubleEndedIterator trait.ExactSizeIterator trait.IntoIterator trait.FromIterator", names.join(" "));
    assert(m.items[1].doc == "Back.\n" && m.items[3].members.len() == 2 && m.items[3].traits.len() == 0, "trait items");
}

#[test]
fn private_reexports_inline() {
    let files: Dict<str, str> = Dict::new();
    files.insert("src/lib.nabi", "pub mod open;\nmod buffer;\nmod glob;\nmod ints;\n/// From buffer.\npub use buffer::{BufReader, LineWriter as Lines};\npub use pkg::open::Shown;\npub use glob::*;\npub fn own() {}\n");
    files.insert("src/buffer.nabi", "/// Reads in chunks.\npub struct BufReader { pub cap: usize; }\nimpl BufReader {\n    /// New.\n    pub fn new() -> BufReader { BufReader { cap: 0 } }\n}\nimpl Read for BufReader {}\npub struct LineWriter<T> {}\npub struct Unused {}\n");
    files.insert("src/open.nabi", "pub struct Shown {}\n");
    files.insert("src/glob.nabi", "mod deep;\npub fn globbed() {}\npub fn own() {}\npub use deep::Deep;\npub use pkg::open::Shown as Again;\n");
    files.insert("src/glob/deep.nabi", "/// Deep.\npub enum Deep { A, B }\n");
    files.insert("src/ints.nabi", "impl i8 {\n    pub fn bits() -> u32 { 8 }\n}\nimpl BufReader {\n    pub fn more(self) {}\n}\n");
    let all = walk(|p| files.get(p), "src/lib.nabi", "k", "");
    assert(all.len() == 6 && all[1].path == "k::open" && all[2].path == "k::buffer" && !all[2].public && !all[4].public, f"{all.len()}");
    let ps = pages(all);
    assert(ps.len() == 2 && ps[0].path == "k" && ps[1].path == "k::open", "only public modules");
    let names: List<str> = List::new();
    for it in ps[0].items { names.push(it.kind + "." + it.name); }
    assert(names.join(" ") == "struct.BufReader struct.Lines use.pkg::open::Shown fn.globbed enum.Deep use.k::open::Shown as Again fn.own", names.join(" "));
    let br = ps[0].items[0];
    assert(br.doc == "From buffer.\n\nReads in chunks.\n" && br.file == "src/buffer.nabi" && br.line == 2, br.doc);
    let ms: List<str> = List::new();
    for mb in br.members { ms.push(mb.name + "@" + mb.file); }
    assert(ms.join(" ") == "cap@ new@ more@src/ints.nabi" && br.traits.len() == 1, ms.join(" "));
    assert(ps[0].items[1].sig == "pub struct Lines<T>", ps[0].items[1].sig);
    assert(ps[0].impls.len() == 1 && ps[0].impls[0].name == "i8" && ps[0].impls[0].members[0].name == "bits", "impls folded");
    // What stays a link resolves among the pages.
    let rs = reexports(ps[0], ps[0].items[2], ps);
    assert(rs.len() == 1 && rs[0].path == "k::open::Shown" && (rs[0].module ?? ps[0]).path == "k::open", "public stays a link");
    let again = reexports(ps[0], ps[0].items[5], ps);
    assert(again.len() == 1 && again[0].name == "Again" && again[0].item is Item, "glob's link");
    // A child module named as the crate.
    let same: Dict<str, str> = Dict::new();
    same.insert("src/lib.nabi", "mod k;\npub use k::Inner;\n");
    same.insert("src/k.nabi", "pub struct Inner {}\n");
    let sp = pages(walk(|p| same.get(p), "src/lib.nabi", "k", ""));
    assert(sp.len() == 1 && sp[0].items.len() == 1 && sp[0].items[0].kind == "struct", "child named as the crate");
    // Kept as NABION (the registry keeps each version's docs).
    let back: List<Module> = try! nabion::from_str(try! nabion::to_str(ps));
    assert(back.len() == 2 && back[0].items[0].members[2].file == "src/ints.nabi" && back[0].items[2].kind == "use" && back[0].impls[0].name == "i8", "nabion");
    assert(scan("x", "", "mod a;\npub(pkg) mod b;\n#[doc(hidden)]\npub mod c;\npub mod d;\npub mod e {}\n").inner.join(",") == "a,b,c", "inner");
}

#[test]
fn partial_and_public_globs() {
    let files: Dict<str, str> = Dict::new();
    files.insert("lib.nabi", "pub mod io;\nmod imp;\npub use imp::{Hidden, Missing};\npub use io::*;\n");
    files.insert("io.nabi", "pub struct Open {}\n");
    files.insert("imp.nabi", "pub struct Hidden {}\n");
    let ps = pages(walk(|p| files.get(p), "lib.nabi", "c", "c/index.html"));
    assert(ps.len() == 2 && ps[1].out == "c/io.html", "pages");
    let it = ps[0].items;
    assert(it.len() == 3 && it[0].name == "Hidden" && it[1].kind == "use" && it[1].skip.join(",") == "Hidden" && it[2].sig == "pub use io::*", f"{it.len()}");
    let rs = reexports(ps[0], it[1], ps);
    assert(rs.len() == 1 && rs[0].name == "Missing" && rs[0].module is none, "unresolved stays");
}

#[test]
fn generic_headers() {
    let m = scan("x", "x.html", "pub struct DictIter<K, V> {\n    pub at: Dict<K, V>;\n}\npub enum E<A, B> { L(A), R { b: Dict<A, B> }, N }\npub fn f<T, U: Into<T>>(a: T, b: U) -> (T, U) where T: Add<Output = T> { (a, b) }\npub const LESS: bool = 1 < 2;\n");
    let sigs: List<str> = List::new();
    for it in m.items { sigs.push(it.sig); }
    assert(sigs.len() == 4 && sigs[0] == "pub struct DictIter<K, V>" && sigs[1] == "pub enum E<A, B>", sigs.join(" | "));
    assert(sigs[2] == "pub fn f<T, U: Into<T>>(a: T, b: U) -> (T, U) where T: Add<Output = T>" && sigs[3] == "pub const LESS: bool = 1 < 2", sigs.join(" | "));
    assert(m.items[0].members.len() == 1 && m.items[0].members[0].sig == "pub at: Dict<K, V>", "field");
    assert(m.items[1].members.len() == 3, f"{m.items[1].members.len()} variants");
}

#[test]
fn internal_items() {
    let m = scan("x", "x.html", "pub struct IoError {}\nimpl IoError {\n    /// Shown.\n    pub fn new() -> IoError { IoError {} }\n    #[internal(\"write `IoError::new()`\")]\n    pub fn resolver(code: i32) -> IoError { IoError {} }\n}\n#[internal]\npub fn hook() {}\npub fn kept() {}\n");
    let names: List<str> = List::new();
    for it in m.items { names.push(it.name); }
    assert(names.join(",") == "IoError,kept", names.join(","));
    assert(m.items[0].members.len() == 1 && m.items[0].members[0].name == "new", "member");
}

#[test]
fn module_docs() {
    assert(lead_doc("//! Lists.\n//!\n//! More.\n// not doc\npub fn f() {}\n") == "Lists.\n\nMore.\n", "inner doc");
    assert(lead_doc("// A plain comment.\npub fn f() {}\n") == "", "plain comment is no doc");
    assert(lead_doc("#!/usr/bin/env nabi\n//! Script.\n") == "Script.\n", "after #!");
}

#[test]
fn index_pages() {
    assert(page_of("k", List::new()) == "k/index.html" && page_of("k", ["index"]) == "k/index/index.html" && page_of("k", ["a", "index"]) == "k/a/index.html", "page_of");
    let files: Dict<str, str> = Dict::new();
    files.insert("lib.nabi", "pub mod index;\npub mod a;\n");
    files.insert("index.nabi", "pub mod deep;\npub struct Range {}\n");
    files.insert("index/deep.nabi", "pub fn d() {}\n");
    files.insert("a.nabi", "pub mod index;\n");
    files.insert("a/index.nabi", "pub fn i() {}\n");
    let ps = pages(walk(|p| files.get(p), "lib.nabi", "c", "c/index.html"));
    let outs: List<str> = List::new();
    for p in ps { outs.push(p.path + "=" + p.out); }
    assert(outs.join(" ") == "c=c/index.html c::index=c/index/index.html c::index::deep=c/index/deep.html c::a=c/a.html c::a::index=c/a/index.html", outs.join(" "));
    let it = Item { kind: "use", name: "list::{List, ListIter as Iter}", sig: "", doc: "", members: List::new(), traits: List::new() };
    assert(anchor(it) == "reexport.List.ListIter.Iter" && anchor(ps[1].items[0]) == "struct.Range", anchor(it));
}
