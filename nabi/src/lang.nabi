//! The languages the Nabi sites speak, and the kit's words in each.
//! English is at a site's root; every other language has a directory of
//! its own (`/ko/`, `/zh-hans/`, `/zh-hant/`) with the same paths below
//! it.

/// A language of the sites. zh-Hant is written as in Taiwan.
#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
pub enum Lang {
    En,
    Ko,
    ZhHans,
    ZhHant,
}

/// Every language, in the language menu's order.
pub const ALL: [Lang; 4] = [Lang::En, Lang::Ko, Lang::ZhHans, Lang::ZhHant];

impl Lang {
    /// The BCP 47 tag, for `lang` and `hreflang`: `en`, `ko`, `zh-Hans`,
    /// `zh-Hant`.
    pub fn code(self) -> str {
        match self {
            Lang::En => "en",
            Lang::Ko => "ko",
            Lang::ZhHans => "zh-Hans",
            Lang::ZhHant => "zh-Hant",
        }
    }

    /// The language's directory under a site root, with its slash: `""`
    /// for English, `ko/`, `zh-hans/`, `zh-hant/`.
    pub fn dir(self) -> str {
        match self {
            Lang::En => "",
            Lang::Ko => "ko/",
            Lang::ZhHans => "zh-hans/",
            Lang::ZhHant => "zh-hant/",
        }
    }

    /// The directory without its slash: `""`, `ko`, `zh-hans`, `zh-hant`.
    pub fn slug(self) -> str {
        let d = self.dir();
        d.trim_end_matches("/")
    }

    /// The language's name in itself, for the language menu.
    pub fn name(self) -> str {
        match self {
            Lang::En => "English",
            Lang::Ko => "한국어",
            Lang::ZhHans => "简体中文",
            Lang::ZhHant => "繁體中文",
        }
    }

    /// og:locale.
    pub fn og_locale(self) -> str {
        match self {
            Lang::En => "en_US",
            Lang::Ko => "ko_KR",
            Lang::ZhHans => "zh_CN",
            Lang::ZhHant => "zh_TW",
        }
    }

    pub fn is_en(self) -> bool { self == Lang::En }

    /// The kit's words in this language.
    pub fn words(self) -> Words {
        match self {
            Lang::En => EN,
            Lang::Ko => KO,
            Lang::ZhHans => ZH_HANS,
            Lang::ZhHant => ZH_HANT,
        }
    }

    /// `p`, a path from a site root without a language (`learn/x.html`),
    /// in this language (`zh-hans/learn/x.html`).
    pub fn path(self, p: str) -> str { self.dir() + p }
}

/// Korean if `ko`, else English: the old `ko: bool` arguments.
pub fn of_ko(ko: bool) -> Lang { if ko { Lang::Ko } else { Lang::En } }

/// The language of a tag or a directory name (`zh-Hans`, `zh-hans`,
/// `ko`; any case), or none.
pub fn of_code(c: str) -> Lang | none {
    let t = c.to_lowercase();
    for l in ALL {
        if t == l.code().to_lowercase() { return l; }
    }
    none
}

/// The language of path `p` from a site root (`zh-hant/learn`,
/// `/ko/download`; a leading `/` is fine) and the path without its
/// directory (`learn`, `/download`). A path in no language's directory
/// is English, as it is.
pub fn split(p: str) -> (Lang, str) {
    let abs = p.starts_with("/");
    let q = if abs { p[1:] } else { p };
    for l in ALL {
        if l.is_en() { continue; }
        let s = l.slug();
        if q == s { return (l, if abs { "/" } else { "" }); }
        if let rest: str = q.strip_prefix(l.dir()) { return (l, if abs { "/" + rest } else { rest }); }
    }
    (Lang::En, p)
}

/// The language of path `p` (split).
pub fn of_path(p: str) -> Lang { split(p).0 }

/// The kit's interface text in one language (Lang::words). Each field
/// says where it shows.
pub struct Words {
    /// The header's theme button: its name, and its title as an action.
    pub dark_theme: str;
    pub to_dark: str;
    pub to_light: str;
    /// The language menu's name.
    pub language: str;
    /// The footer's theme switch.
    pub theme: str;
    pub system: str;
    pub light: str;
    pub dark: str;
    /// The search palette's button.
    pub search: str;
    /// The bar of Nabi sites.
    pub sites: str;
    pub home: str;
    pub docs: str;
    pub packages: str;
    pub playground: str;
    /// Copy buttons.
    pub copy: str;
    pub copied: str;
    /// The footer's columns (chrome::site_cols).
    pub reference: str;
    pub ecosystem: str;
    pub project: str;
    pub guide: str;
    pub examples: str;
    pub error_codes: str;
    pub package_docs: str;
    pub language_spec: str;
    pub std_library: str;
    pub tools: str;
    pub publishing: str;
    pub news: str;
    pub releases: str;
    pub roadmap: str;
    pub faq: str;
    pub community: str;
    pub governance: str;
    pub brand: str;
    pub security: str;
    pub contact: str;
    /// The legal links (chrome::legal_links).
    pub privacy: str;
    pub terms: str;
    pub package_policy: str;
    /// The skip link, and a 404 page's title.
    pub skip: str;
    pub not_found: str;
    /// The sentence after the brand in the footer: the slogan.
    pub tagline: str;
}

