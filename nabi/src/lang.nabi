#[test]
fn languages() {
    assert(Lang::ZhHans.code() == "zh-Hans" && Lang::ZhHant.dir() == "zh-hant/" && Lang::En.dir() == "" && Lang::Ko.slug() == "ko", "codes and directories");
    assert(Lang::ZhHant.name() == "繁體中文" && Lang::ZhHans.og_locale() == "zh_CN" && Lang::ZhHant.og_locale() == "zh_TW", "names");
    assert(of_code("zh-hans") is Lang && (of_code("ZH-HANT") ?? Lang::En) == Lang::ZhHant && of_code("fr") is none, "of_code");
    let (l, rest) = split("zh-hant/learn/a.html");
    assert(l == Lang::ZhHant && rest == "learn/a.html", rest);
    let (l2, rest2) = split("/ko/download");
    assert(l2 == Lang::Ko && rest2 == "/download", rest2);
    let (l3, rest3) = split("/zh-hans");
    assert(l3 == Lang::ZhHans && rest3 == "/", rest3);
    let (l4, rest4) = split("kolkata/x");
    assert(l4 == Lang::En && rest4 == "kolkata/x", "a directory that only starts like one");
    assert(Lang::ZhHans.path("std/index.html") == "zh-hans/std/index.html" && of_ko(true) == Lang::Ko && of_path("learn") == Lang::En, "paths");
    assert(Lang::Ko.words().to_dark == "다크 테마로 바꾸기" && Lang::ZhHant.words().packages == "套件" && Lang::ZhHans.words().packages == "包", "words");
}
